# Supabase project — Settings → API. Both values are safe to ship to the browser;
# every table is protected by row level security, so the anon key grants nothing on its own.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Leave unset (or "false") to talk to Supabase. Set to "true" to run the whole portal
# against the built-in demo dataset with no backend at all — useful for design review.
VITE_USE_MOCK=true

# The client statement is closed against a real backend until row level security
# policies exist that let a client read their own ledger — without them RLS returns
# nothing and the page would show zero passes to someone who has earned plenty.
# Set to "true" once those policies are in place. Demo mode ignores this and always
# shows the client view.
VITE_CLIENT_PORTAL=false

# NEVER put the Supabase service role key in a VITE_ variable. It belongs only in a
# Cloudflare Worker secret (`wrangler secret put SUPABASE_SERVICE_ROLE_KEY`), because
# anything prefixed VITE_ is compiled into the JavaScript bundle the browser downloads.
